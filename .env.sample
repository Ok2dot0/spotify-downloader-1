# Spotify API Credentials - Get these from https://developer.spotify.com/dashboard/
SPOTIPY_CLIENT_ID=your_spotify_client_id_here
SPOTIPY_CLIENT_SECRET=your_spotify_client_secret_here

# AI/Multimodal API Credentials (Optional - for AI Music Discovery features)
# Choose one or more providers:
# OPENAI_API_KEY=your_openai_api_key_here           # For OpenAI's GPT-4 Vision
# OLLAMA_BASE_URL=http://localhost:11434            # For local Ollama server
# ANTHROPIC_API_KEY=your_anthropic_api_key_here     # For Claude 3 Vision

# AI Settings
# AI_PROVIDER=ollama                                # Options: ollama, openai, anthropic
# AI_MODEL=llama3.2-vision:latest                  # Model name for the chosen provider
# AI_ENABLE_VISION=true                            # Enable image analysis features

# Optional: Default paths and settings
# DOWNLOAD_DIR=/path/to/download/directory
# DVD_DRIVE=E:
# MAX_THREADS=3
# AUDIO_FORMAT=mp3
# AUDIO_BITRATE=320k

# Optional: Logging settings
# LOG_LEVEL=INFO